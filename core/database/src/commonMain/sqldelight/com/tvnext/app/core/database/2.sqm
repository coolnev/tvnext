-- Migration 2: EPG support, watch history, playlist EPG url.
ALTER TABLE playlist ADD COLUMN url_tvg TEXT;

CREATE TABLE IF NOT EXISTS epg_channel (
    id TEXT NOT NULL PRIMARY KEY,
    display_names TEXT NOT NULL DEFAULT '',
    icon_url TEXT
);

CREATE TABLE IF NOT EXISTS epg_programme (
    channel_id TEXT NOT NULL,
    start_time INTEGER NOT NULL,
    stop_time INTEGER NOT NULL,
    title TEXT NOT NULL,
    description TEXT,
    category TEXT,
    episode_num TEXT
);

CREATE INDEX IF NOT EXISTS idx_epg_programme_channel_start ON epg_programme(channel_id, start_time);

CREATE TABLE IF NOT EXISTS epg_cache (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    url TEXT NOT NULL DEFAULT '',
    fetched_at INTEGER,
    source TEXT NOT NULL DEFAULT '',
    last_error TEXT,
    channel_count INTEGER NOT NULL DEFAULT 0,
    programme_count INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS history (
    channel_id TEXT NOT NULL PRIMARY KEY,
    watched_at INTEGER NOT NULL
);
