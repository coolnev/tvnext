-- Migration 9: EPG active-batch indexes.
--
-- Every hot EPG query filters by playlist_id + batch_id before channel/time.
-- The old indexes omitted batch_id, forcing SQLite to scan rows from old and
-- new batches during a replacement. The new indexes match the actual WHERE
-- clauses and are rebuilt once after each bulk import.

DROP INDEX IF EXISTS idx_epg_programme_channel_start;
DROP INDEX IF EXISTS idx_epg_programme_playlist_start;
DROP INDEX IF EXISTS idx_epg_programme_lower_title;

CREATE INDEX IF NOT EXISTS idx_epg_programme_channel_start
    ON epg_programme(playlist_id, batch_id, channel_id, start_time);

CREATE INDEX IF NOT EXISTS idx_epg_programme_playlist_start
    ON epg_programme(playlist_id, batch_id, start_time, stop_time);

CREATE INDEX IF NOT EXISTS idx_epg_programme_lower_title
    ON epg_programme(playlist_id, batch_id, lower_title);
