CREATE TABLE tmdb_cache (
    media_item_id TEXT NOT NULL PRIMARY KEY,
    tmdb_id INTEGER,
    media_type TEXT NOT NULL DEFAULT '',
    title TEXT,
    original_title TEXT,
    overview TEXT,
    poster_path TEXT,
    backdrop_path TEXT,
    release_date TEXT,
    vote_average REAL,
    genres TEXT NOT NULL DEFAULT '',
    runtime_minutes INTEGER,
    director TEXT,
    cast TEXT NOT NULL DEFAULT '',
    original_language TEXT,
    updated_at INTEGER NOT NULL,
    status TEXT NOT NULL
);

selectByMediaItemId:
SELECT * FROM tmdb_cache WHERE media_item_id = ?;

upsert:
INSERT OR REPLACE INTO tmdb_cache(
    media_item_id, tmdb_id, media_type, title, original_title, overview,
    poster_path, backdrop_path, release_date, vote_average, genres,
    runtime_minutes, director, cast, original_language, updated_at, status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM tmdb_cache;

count:
SELECT COUNT(*) FROM tmdb_cache;
