-- Migration 3: multiple playlists, VOD media library, typed watch history,
-- EPG scoped per playlist.

ALTER TABLE playlist ADD COLUMN type TEXT NOT NULL DEFAULT 'LIVE';
ALTER TABLE playlist ADD COLUMN is_default INTEGER NOT NULL DEFAULT 0;

CREATE TABLE IF NOT EXISTS media_item (
    id TEXT NOT NULL PRIMARY KEY,
    playlist_id TEXT NOT NULL,
    number INTEGER NOT NULL,
    name TEXT NOT NULL,
    stream_url TEXT NOT NULL,
    logo_url TEXT,
    category TEXT NOT NULL DEFAULT '',
    tvg_id TEXT,
    tvg_name TEXT,
    duration_seconds INTEGER,
    season TEXT,
    episode TEXT,
    is_favorite INTEGER NOT NULL DEFAULT 0
);

-- Watch history gains a content type; existing channel history becomes LIVE.
ALTER TABLE history RENAME TO history_old;
CREATE TABLE history (
    item_id TEXT NOT NULL,
    content_type TEXT NOT NULL,
    watched_at INTEGER NOT NULL,
    PRIMARY KEY (item_id, content_type)
);
INSERT INTO history (item_id, content_type, watched_at)
    SELECT channel_id, 'LIVE', watched_at FROM history_old;
DROP TABLE history_old;

-- EPG becomes playlist-scoped. Existing cache is attached to the first enabled
-- LIVE playlist (or kept as 'legacy' when no playlist exists yet).
ALTER TABLE epg_programme ADD COLUMN playlist_id TEXT NOT NULL DEFAULT '';

ALTER TABLE epg_channel RENAME TO epg_channel_old;
CREATE TABLE epg_channel (
    playlist_id TEXT NOT NULL,
    id TEXT NOT NULL,
    display_names TEXT NOT NULL DEFAULT '',
    icon_url TEXT,
    PRIMARY KEY (playlist_id, id)
);
INSERT INTO epg_channel (playlist_id, id, display_names, icon_url)
    SELECT COALESCE((SELECT id FROM playlist WHERE enabled = 1 AND type = 'LIVE' ORDER BY rowid LIMIT 1), 'legacy'),
           id, display_names, icon_url
    FROM epg_channel_old;
DROP TABLE epg_channel_old;

UPDATE epg_programme SET playlist_id = 'legacy' WHERE playlist_id = '';

DROP INDEX IF EXISTS idx_epg_programme_channel_start;
CREATE INDEX IF NOT EXISTS idx_epg_programme_channel_start ON epg_programme(playlist_id, channel_id, start_time);

ALTER TABLE epg_cache RENAME TO epg_cache_old;
CREATE TABLE epg_cache (
    playlist_id TEXT NOT NULL PRIMARY KEY,
    url TEXT NOT NULL DEFAULT '',
    fetched_at INTEGER,
    source TEXT NOT NULL DEFAULT '',
    last_error TEXT,
    channel_count INTEGER NOT NULL DEFAULT 0,
    programme_count INTEGER NOT NULL DEFAULT 0
);
INSERT OR REPLACE INTO epg_cache (playlist_id, url, fetched_at, source, last_error, channel_count, programme_count)
    SELECT COALESCE((SELECT id FROM playlist WHERE enabled = 1 AND type = 'LIVE' ORDER BY rowid LIMIT 1), 'legacy'),
           url, fetched_at, source, last_error, channel_count, programme_count
    FROM epg_cache_old;
DROP TABLE epg_cache_old;
