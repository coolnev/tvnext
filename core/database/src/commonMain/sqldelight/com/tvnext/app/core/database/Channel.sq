CREATE TABLE channel (
    id TEXT NOT NULL PRIMARY KEY,
    playlist_id TEXT NOT NULL,
    number INTEGER NOT NULL,
    name TEXT NOT NULL,
    stream_url TEXT NOT NULL,
    logo_url TEXT,
    category TEXT NOT NULL DEFAULT '',
    tvg_id TEXT,
    tvg_name TEXT,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    catchup TEXT,
    catchup_days INTEGER,
    catchup_source TEXT,
    catchup_type TEXT,
    timeshift TEXT
);

insertChannel:
INSERT OR REPLACE INTO channel(
    id, playlist_id, number, name, stream_url, logo_url, category, tvg_id, tvg_name, is_favorite,
    catchup, catchup_days, catchup_source, catchup_type, timeshift
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllChannels:
SELECT * FROM channel ORDER BY number ASC;

selectChannelsByPlaylist:
SELECT * FROM channel WHERE playlist_id = ? ORDER BY number ASC;

selectChannelById:
SELECT * FROM channel WHERE id = ?;

deleteChannelsByPlaylist:
DELETE FROM channel WHERE playlist_id = ?;

deleteAllChannels:
DELETE FROM channel;

setFavorite:
UPDATE channel SET is_favorite = ? WHERE id = ?;

-- Stable-id migration: rewrites a channel's id (favorites travel with the row).
updateChannelId:
UPDATE channel SET id = ? WHERE id = ?;

deleteChannelById:
DELETE FROM channel WHERE id = ?;

selectFavoriteIds:
SELECT id FROM channel WHERE is_favorite = 1;

countChannelsByPlaylist:
SELECT COUNT(*) FROM channel WHERE playlist_id = ?;
